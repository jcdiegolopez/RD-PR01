# Crea un archivo .env local desde esta plantilla y coloca tu propia clave.
GEMINI_API_KEY=reemplaza_con_tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
# Carpeta aislada que usarán los servidores oficiales Filesystem y Git.
MCP_DEMO_WORKSPACE=data/mcp-demo-workspace
# Ruta absoluta al server.py del Spring Architecture Analyzer MCP.
# Ejemplo Windows: C:\Users\tu_usuario\...\spring-architecture-analyzer-mcp\server.py
# Dejar vacío para omitir el servidor de arquitectura.
ARCH_SERVER_PATH=
